<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ja</string>
		<string>ko</string>
		<string>zh-Hans</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Kairos</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Kairos</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Only standard HTTPS/TLS is used (Firebase, Gemini API, Open-Meteo) —
	     no proprietary encryption — so this is exempt from export compliance
	     and Connect won't ask the encryption question on future submissions. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAlarmKitUsageDescription</key>
	<string>アラーム・タイマー・アラーム形式の予定を、マナーモード中やアプリを閉じているときでも時間どおりに鳴らすために使用します。</string>
	<key>NSCameraUsageDescription</key>
	<string>グループのトークで写真を撮って送ったり、グループの招待QRコードを読み取ったりするために使用します。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>グループのトークで写真を選んで送るために使用します。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>グループのトークで現在地を送るために使用します。送るボタンを押したときだけ取得します。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>グループのトークでボイスメッセージを録音したり、音声で文字を入力したりするために使用します。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>グループのトークで、話した言葉を文字に変換して入力するために使用します。</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Kairosを開くときに、パスワードの代わりにFace IDでご本人確認を行うために使用します。</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- REVERSED_CLIENT_ID from GoogleService-Info.plist — required
				     for the Google Sign-In OAuth redirect (Settings > link
				     Google account) to complete on iOS. -->
				<string>com.googleusercontent.apps.889968355663-1fcdmllp4fnmdmml5lc81okt9088qurp</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<!-- Lets a push notification be delivered to the app while it's
		     backgrounded/not running, for the schedule-reminder push
		     (functions/src/scheduledReminders.ts). -->
		<string>remote-notification</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
