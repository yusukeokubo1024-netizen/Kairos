<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The only signed iOS pipeline (codemagic.yaml ios-release) archives
	     with an App Store distribution profile, which embeds
	     aps-environment=production — must match or export fails. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
