rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // ユーザー認証ユーティリティ
    // ============================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ============================================
    // users コレクション（メールアドレスなど本人限定の情報）
    // ============================================
    match /users/{uid} {
      // 本人のみ読み書き可能。メールアドレスなどはグループメンバーにも見せない。
      allow read: if isOwner(uid);
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow update: if isOwner(uid) && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(uid);
    }

    // ============================================
    // publicProfiles コレクション（表示名のみ。グループ/予定メンバーへの表示用）
    // ============================================
    match /publicProfiles/{uid} {
      // UID を知っている相手（同じグループ/予定のメンバー）だけが表示名を取得できる。
      // 一覧取得は禁止し、全ユーザーの列挙・スクレイピングを防ぐ。
      allow get: if isAuthenticated();
      allow list: if false;
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // ============================================
    // schedules コレクション（予定）
    // ============================================
    match /schedules/{scheduleId} {
      // オーナーと参加者が閲覧可能。編集・削除はオーナーのみ。
      allow read: if isAuthenticated() &&
        (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.participantIds);
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid &&
        request.auth.uid in request.resource.data.participantIds;
      allow update: if isAuthenticated() && resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // ============================================
    // tasks コレクション
    // ============================================
    match /tasks/{taskId} {
      allow read, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    // ============================================
    // sharedGroups コレクション（共有グループ）
    // ============================================
    match /sharedGroups/{groupId} {
      // フルドキュメント（memberIds＝実在するUIDの一覧を含む）は、
      // 実際のメンバーだけが読める。招待コードだけを知る非メンバーへの
      // プレビューは、下の groupInvitePreviews（名前と人数だけ）で行う。
      allow get, list: if isAuthenticated() && request.auth.uid in resource.data.memberIds;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid &&
        request.auth.uid in request.resource.data.memberIds;
      allow update: if isAuthenticated() && (
        // オーナーによる編集（オーナー自体の変更は不可。メンバー削除＝キックもここに含まれる）
        (resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId) ||
        // 招待コード（グループID）を知る本人が、自分自身だけをメンバーに追加する（参加）。
        // サイズ差分だけのチェックだと「自分を追加しつつ別の誰かを外す」ような
        // 抜け道が生まれるため、結果の配列が「元の配列＋自分のUID」と完全一致
        // することまで検証する。
        (
          !(request.auth.uid in resource.data.memberIds) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt']) &&
          request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
        ) ||
        // メンバー本人が自分自身だけをメンバーから外す（退出。オーナーは退出不可＝グループ削除のみ）。
        // 同様に、結果の配列が「元の配列から自分のUIDだけを除いたもの」と
        // 完全一致することまで検証し、他人を巻き添えで外したり別UIDを
        // 紛れ込ませたりできないようにする。
        (
          request.auth.uid != resource.data.ownerId &&
          request.auth.uid in resource.data.memberIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt']) &&
          request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
        ) ||
        // 任意のメンバーが「予定を追加した」等のお知らせ表示（プッシュ通知の
        // 代わりの、無料でできるアプリ内通知）だけを更新できる。他のフィールド
        // には触れられない。timestamp偽造防止のため request.time と一致必須。
        (
          request.auth.uid in resource.data.memberIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActivityAt', 'lastActivityText']) &&
          request.resource.data.lastActivityAt == request.time
        )
      );
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // ============================================
      // messages サブコレクション（グループのトーク）
      // ============================================
      match /messages/{messageId} {
        function isGroupMember() {
          return request.auth.uid in
            get(/databases/$(database)/documents/sharedGroups/$(groupId)).data.memberIds;
        }

        allow read: if isAuthenticated() && isGroupMember();
        allow create: if isAuthenticated() && isGroupMember() &&
          request.resource.data.senderId == request.auth.uid;
        // Any group member can react, but only the "reactions" field may
        // change — the message text/sender can't be tampered with this way.
        allow update: if isAuthenticated() && isGroupMember() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      }

      // ============================================
      // joinRequests サブコレクション（招待コードで参加を希望した人の
      // 「参加リクエスト」。ドキュメントIDは申請者自身のUID固定にして
      // 二重申請を防ぐ。即時参加はせず、オーナーが承認して初めて
      // memberIds に追加される）
      // ============================================
      match /joinRequests/{requesterId} {
        function isGroupOwner() {
          return get(/databases/$(database)/documents/sharedGroups/$(groupId)).data.ownerId == request.auth.uid;
        }
        function isAlreadyMember() {
          return request.auth.uid in
            get(/databases/$(database)/documents/sharedGroups/$(groupId)).data.memberIds;
        }

        allow create: if isAuthenticated() &&
          requesterId == request.auth.uid &&
          request.resource.data.requesterId == request.auth.uid &&
          request.resource.data.groupId == groupId &&
          !isAlreadyMember() &&
          request.resource.data.requestedAt == request.time &&
          request.resource.data.keys().hasOnly(['requesterId', 'groupId', 'requestedAt']);
        allow get: if isAuthenticated() &&
          (resource.data.requesterId == request.auth.uid || isGroupOwner());
        allow list: if isAuthenticated() && isGroupOwner();
        allow delete: if isAuthenticated() &&
          (resource.data.requesterId == request.auth.uid || isGroupOwner());
        allow update: if false;
      }
    }

    // ============================================
    // messageReports コレクション（不適切なメッセージの通報。
    // 書き込み専用 — アプリからは読み返さない。運営がFirebase Console
    // から確認する。通報者本人・実際にそのグループのメンバーであること
    // ・偽造されたタイムスタンプでないことを検証する）
    // ============================================
    match /messageReports/{reportId} {
      // 通報対象のメッセージが実在し、通報内容(送信者・本文)が実物と
      // 一致していることまで検証する。これがないと、実在するグループ
      // メンバーが他のメンバーになすりつけた架空の内容で虚偽通報を
      // 作成できてしまう。
      function reportMatchesRealMessage(data) {
        let msg = get(/databases/$(database)/documents/sharedGroups/$(data.groupId)/messages/$(data.messageId)).data;
        return msg.senderId == data.messageSenderId && msg.text == data.messageText;
      }

      allow create: if isAuthenticated() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.auth.uid in
          get(/databases/$(database)/documents/sharedGroups/$(request.resource.data.groupId)).data.memberIds &&
        reportMatchesRealMessage(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.keys().hasOnly(
          ['reporterId', 'groupId', 'messageId', 'messageSenderId', 'messageText', 'createdAt']);
      allow read, update, delete: if false;
    }

    // ============================================
    // groupInvitePreviews コレクション（招待コードだけを知る非メンバー
    // 向けの、参加前プレビュー専用データ。グループ名と人数だけを持ち、
    // memberIds（実在するUIDの一覧）は一切含まない）
    // ============================================
    match /groupInvitePreviews/{groupId} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['name', 'memberCount', 'ownerId']);
      allow update: if isAuthenticated() && (
        // オーナーによる名前変更（オーナー自体の変更は不可）
        (resource.data.ownerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])) ||
        // 参加時、人数を1人分だけ増やす（それ以外は変更不可）
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']) &&
          request.resource.data.memberCount == resource.data.memberCount + 1) ||
        // 退出・キック時、人数を1人分だけ減らす
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']) &&
          request.resource.data.memberCount == resource.data.memberCount - 1)
      );
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // ============================================
    // calendarShares コレクション（アプリを入れていない相手にも見せる、
    // 閲覧専用のカレンダー共有リンク。ドキュメントIDは推測不可能な
    // ランダムトークンで、それ自体がアクセス制御になる。所有者以外は
    // タイトル・日時以外の情報（場所・メモ・参加者名など）に一切
    // アクセスできない）
    // ============================================
    match /calendarShares/{token} {
      // トークンを知っていれば誰でも閲覧できる（未ログインの相手向け）。
      // 列挙（list）は禁止し、全トークンの総当たりを防ぐ。
      allow get: if true;
      allow list: if false;
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.keys().hasOnly(['ownerId', 'ownerName', 'createdAt']);
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // ============================================
      // schedules サブコレクション（タイトルと日時だけの複製データ）
      // ============================================
      match /schedules/{scheduleId} {
        function isShareOwner() {
          return get(/databases/$(database)/documents/calendarShares/$(token)).data.ownerId ==
            request.auth.uid;
        }

        allow get, list: if true;
        allow create, update: if isAuthenticated() && isShareOwner() &&
          request.resource.data.keys().hasOnly(['title', 'startTime', 'endTime']);
        allow delete: if isAuthenticated() && isShareOwner();
      }
    }

    // ============================================
    // anniversaries コレクション（毎年通知したい記念日）
    // ============================================
    match /anniversaries/{anniversaryId} {
      allow read, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    // ============================================
    // config コレクション（FAQ文言など、アプリ側から読むだけの
    // 静的な設定。編集はFirebase Console/スクリプト経由のみ）
    // ============================================
    match /config/{document} {
      allow read: if true;
      allow write: if false;
    }

    // ============================================
    // auditLogs コレクション（誰が・いつ・何をしたかの監査ログ。
    // 書き込み専用 — アプリからは読み返さない。本人になりすまし・
    // 偽造(過去/未来の日時、でたらめなaction)を防ぐため、
    // actorId・action・timestamp・フィールド構成まで厳密に検証する）
    // ============================================
    match /auditLogs/{logId} {
      allow create: if isAuthenticated() &&
        request.resource.data.actorId == request.auth.uid &&
        request.resource.data.action in ['create', 'update', 'delete'] &&
        request.resource.data.collection in ['schedules', 'tasks', 'anniversaries', 'sharedGroups'] &&
        // FieldValue.serverTimestamp() resolves to exactly request.time —
        // this rejects any client-supplied (backdated/future) timestamp.
        request.resource.data.timestamp == request.time &&
        request.resource.data.keys().hasOnly(
          ['actorId', 'action', 'collection', 'targetId', 'changedFields', 'timestamp']);
      allow read, update, delete: if false;
    }

    // ============================================
    // trash コレクション（誤削除からの復元用。削除時に元データの
    // スナップショットを保存しておく。本人のものだけ読み書き可。
    // 元ドキュメントの所有者本人でなければ、他人のデータを自分の
    // ゴミ箱に取り込むことはできない）
    // ============================================
    match /trash/{trashId} {
      allow read, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.collection in ['schedules', 'tasks', 'anniversaries', 'sharedGroups'] &&
        get(/databases/$(database)/documents/$(request.resource.data.collection)/$(request.resource.data.originalId)).data.ownerId == request.auth.uid &&
        request.resource.data.keys().hasOnly(
          ['ownerId', 'collection', 'originalId', 'data', 'deletedAt']);
      allow update: if false;
    }

    // デフォルト: アクセス拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
